MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=tutora
# Optional, comma-separated DNS resolver IPs if Node cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=192.168.1.1
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verification-token
WHATSAPP_TOKEN=replace-with-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v26.0
META_APP_SECRET=replace-with-meta-app-secret
ADMIN_PHONES=country-code-and-number-without-plus
CRON_SECRET=replace-with-a-long-random-secret
ANTHROPIC_API_KEY=
WA_NOTIFY_TEMPLATE=
INSTITUTE_NAME=Tutora
INSTITUTE_TAGLINE=
CONTACT_ETA=shortly
PAYMENT_INFO=
